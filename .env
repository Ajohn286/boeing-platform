#   * v1.0 (01/08/2025): Initial creation for Docker deployment
# Description     : Template for environment variables configuration
# *******************

# Application Configuration
NODE_ENV=production
PORT=5000
VITE_PORT=5173

# Database Configuration
DATABASE_URL=postgresql://airbus_user:airbus_pass@localhost:5432/airbus_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airbus_db
DB_USER=airbus_user
DB_PASSWORD=airbus_pass

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=airbus_redis_pass

# Auth0 Configuration (replace with your actual values)
AUTH0_SECRET=your-super-secret-auth0-secret-key-here
AUTH0_BASE_URL=http://localhost:5000
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
SESSION_TIMEOUT=3600000

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/*,application/pdf,text/*

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/airbus.log

# Security Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_DEBUG=false
ENABLE_METRICS=true

# External Services (if applicable)
API_BASE_URL=http://localhost:5000/api
EXTERNAL_API_KEY=your-external-api-key
EXTERNAL_API_URL=https://api.external-service.com

# Docker-specific
COMPOSE_PROJECT_NAME=airbus-review-lhm 